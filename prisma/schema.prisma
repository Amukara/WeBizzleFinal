// WeBizzle — Kenyan neighbourhood shopping comparison
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id       String  @id
  name     String
  unit     String
  emoji    String
  category String
  basePrice Int
  listings VendorProduct[]

  @@index([category])
}

model Vendor {
  id          String   @id @default(cuid())
  name        String
  emoji       String
  type        String   // Mama Mboga, Duka, Pharmacy, etc.
  location    String
  rating      Float    @default(4.5)
  deliveryFee Int      @default(100)
  etaMinutes  Int      @default(25)
  listings    VendorProduct[]
  orders      Order[]
  createdAt   DateTime @default(now())

  // --- Direct-to-vendor payment (no payment gateway required) ---
  // Customers pay the vendor's own M-Pesa number/till/paybill directly, or
  // pay the rider cash on delivery. At least one of these should be set,
  // or acceptsCod left true, for the vendor to be orderable.
  pochiNumber    String?  // Pochi la Biashara / personal "Send Money" number
  tillNumber     String?  // Buy Goods & Services till number
  paybillNumber  String?  // Lipa na M-Pesa Paybill number
  paybillAccount String?  // Paybill account name/number, if required
  acceptsCod     Boolean  @default(true) // Cash on delivery to the rider

  @@index([type])
}

model VendorProduct {
  id        String  @id @default(cuid())
  vendorId  String
  productId String
  price     Int
  inStock   Boolean @default(true)

  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([vendorId, productId])
  @@index([productId])
}

model Order {
  id           String   @id @default(cuid())
  customerName String
  phone        String
  location     String
  vendorId     String
  itemsJson    String   // JSON-serialised line items
  subtotal     Int
  deliveryFee  Int
  total        Int
  status       String   @default("PLACED") // PLACED, CONFIRMED, DISPATCHED, DELIVERED
  // PENDING → AWAITING_CONFIRMATION (customer says they paid direct) → PAID
  // (also PAID is set directly for COD on delivery) | FAILED | CANCELLED
  paymentStatus String @default("PENDING")
  paymentMethod String  @default("COD") // POCHI, TILL, PAYBILL, COD
  mpesaCode    String?  // customer-submitted M-Pesa confirmation code (self-reported, for reconciliation)
  mpesaCheckoutId String? // legacy Daraja CheckoutRequestID — unused while Daraja access is unavailable
  paymentConfirmedBy String? // "VENDOR" | "ADMIN" | "RIDER" | null
  paymentConfirmedAt DateTime?
  // Live tracking
  riderName    String?
  riderPlate   String?
  riderPhone   String?
  riderRating  Float    @default(0)
  saved        Int      @default(0) // KES saved vs. market-average prices
  // Monetisation
  platformFee  Int      @default(0) // 3% levy when total > 300
  driverLevy   Int      @default(0) // 10% of deliveryFee charged to rider
  vendorPayout Int      @default(0) // subtotal - platformFee
  driverPayout Int      @default(0) // deliveryFee - driverLevy
  referralCode String?  // referral code used on this order (if any)
  // Geolocation for Google Maps delivery + rider tracking
  lat          Float?   // customer delivery latitude
  lng          Float?   // customer delivery longitude
  createdAt    DateTime @default(now())

  vendor       Vendor   @relation(fields: [vendorId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([mpesaCheckoutId])
  @@index([vendorId])
  // Speeds up "orders awaiting my confirmation" in the vendor portal.
  @@index([vendorId, paymentStatus])
  // Note: the customer order-lookup query matches on phone suffix
  // (`endsWith`), which a plain B-tree index can't accelerate in Postgres.
  // This index still helps exact-match/prefix lookups; if phone-suffix
  // lookup becomes a hot path at scale, add a trigram (pg_trgm) index instead.
  @@index([phone])
}

model VendorApplication {
  id               String   @id @default(cuid())
  shopName         String
  ownerName        String
  phone            String
  logo             String?  // base64 data URL of the shop logo
  // Verification documents (base64 data URLs)
  tradeLicense     String?  // trade licence photo
  municipalLicense String?  // municipal / single business permit
  kplcToken        String?  // KPLC meter token payment receipt
  // Direct-to-vendor payment details, collected at signup so they're ready
  // to copy onto the live Vendor record once an admin approves the shop.
  pochiNumber      String?
  tillNumber       String?
  paybillNumber    String?
  paybillAccount   String?
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt        DateTime @default(now())
}

model RiderApplication {
  id           String   @id @default(cuid())
  fullName     String
  phone        String
  bikePlate    String
  stageNumber  String   // Stage / matatu stage number for identification
  locationArea String   // Location / area of operation
  selfieUrl    String?  // base64 data URL of rider selfie for verification
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}

// Vendor-paid profile boosts
model BoostCampaign {
  id          String   @id @default(cuid())
  vendorId    String?  // null until an admin links it to an approved vendor
  shopName    String   // captured at purchase time
  phone       String
  package     String   // SILVER, GOLD, PLATINUM
  price       Int      // KES paid
  startsAt    DateTime @default(now())
  endsAt      DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED, PAUSED
  mpesaCode   String?
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([endsAt])
}

// Referral system (low-cost: WhatsApp/SMS share links, in-app tracking)
model Referral {
  id           String   @id @default(cuid())
  code         String   @unique // human-readable, e.g. WANJIRU7
  ownerName    String
  ownerPhone   String
  clicks       Int      @default(0)
  signups      Int      @default(0)
  orders       Int      @default(0) // referees who placed an order
  rewardEarned Int      @default(0) // KES credit earned
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  @@index([code])
}

// Receipts uploaded by customers for data collection → token rewards
model ReceiptSubmission {
  id             String   @id @default(cuid())
  customerPhone  String
  retailerName   String?  // VLM-extracted
  extractedTotal Int      @default(0) // VLM-extracted KES total
  receiptDate    String?  // VLM-extracted
  receiptUrl     String   // base64 data URL
  tokensAwarded  Int      @default(0) // 10 tokens per approved receipt
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// Operator dashboard users (real per-admin auth, not a shared passcode).
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   // scrypt hash: "scrypt:<saltHex>:<hashHex>"
  role         String   @default("ADMIN") // ADMIN, SUPER_ADMIN
  createdAt    DateTime @default(now())
}

// Vendor portal profile: duty hours + online status for order allocation.
model VendorPortal {
  id           String   @id @default(cuid())
  vendorId     String   @unique // links to a seeded Vendor (v1..v6) or approved application
  shopName     String
  phone        String
  isOnline     Boolean  @default(false)
  dutyStart    String   @default("07:00") // HH:mm
  dutyEnd      String   @default("21:00") // HH:mm
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([isOnline])
}

// Rider portal profile: online status for dispatch allocation.
model RiderPortal {
  id           String   @id @default(cuid())
  riderKey     String   @unique // phone or plate, used to log in
  fullName     String
  phone        String
  plate        String
  isOnline     Boolean  @default(false)
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([isOnline])
}

// In-app notifications (vendor/rider order alerts, admin broadcasts).
model Notification {
  id          String   @id @default(cuid())
  recipientType String  // VENDOR, RIDER, ADMIN
  recipientId String   // vendorId / riderKey / "admin"
  type        String   // NEW_ORDER, ORDER_STATUS, CHAT, SYSTEM
  title       String
  body        String
  read        Boolean  @default(false)
  orderId     String?
  createdAt   DateTime @default(now())

  @@index([recipientType, recipientId])
  @@index([createdAt])
}

// Chat messages between vendor/rider and admin support.
model ChatMessage {
  id         String   @id @default(cuid())
  channel    String   // "vendor:{vendorId}" or "rider:{riderKey}" or "admin"
  senderType String   // VENDOR, RIDER, ADMIN
  senderId   String
  senderName String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([channel, createdAt])
}

// OTP codes for phone verification (vendor & rider login)
model OtpCode {
  id        String   @id @default(cuid())
  phone     String   // normalised phone (e.g. 254711223344)
  code      String   // 6-digit code
  purpose   String   // VENDOR_LOGIN, RIDER_LOGIN, VENDOR_SIGNUP, RIDER_SIGNUP
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

